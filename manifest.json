{
  "manifest_version": 3,
  "name": "Ultimate Guitar to ChordPro Converter",
  "version": "1.0.1",
  "description": "Converts any Ultimate Guitar tab or chord page into clean, standard ChordPro (.cho) format.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://tabs.ultimate-guitar.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Convert Tab to ChordPro"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tabs.ultimate-guitar.com/*"
      ],
      "js": [
        "converter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
